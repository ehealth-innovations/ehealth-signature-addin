{
  "name": "ehealth-signature-addin",
  "version": "1.0.0",
  "private": true,
  "description": "Centrally managed Outlook e-mail signature for Ehealth Innovations (event-based Outlook add-in, no backend).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "preview": "node build.mjs && open dist/preview.html",
    "validate": "npx --yes office-addin-manifest validate dist/manifest.xml",
    "deploy": "node build.mjs && npx --yes @azure/static-web-apps-cli deploy ./dist --env production"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
